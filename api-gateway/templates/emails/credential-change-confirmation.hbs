<html>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Credential Change Confirmation - SkillMind</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            background-color: #f5f5f5;
            margin: 0;
            padding: 20px;
        }
        .container {
            max-width: 600px;
            margin: 0 auto;
            background-color: #ffffff;
            border-radius: 8px;
            box-shadow: 0 2px 8px rgba(0,0,0,0.1);
            overflow: hidden;
        }
        .header {
            background: linear-gradient(135deg, #4caf50 0%, #45a049 100%);
            color: white;
            padding: 30px 20px;
            text-align: center;
        }
        .header h1 {
            margin: 0;
            font-size: 28px;
        }
        .content {
            padding: 30px;
        }
        .message {
            color: #333;
            line-height: 1.6;
            margin-bottom: 20px;
            font-size: 16px;
        }
        .success-box {
            background-color: #e8f5e9;
            border-left: 4px solid #4caf50;
            padding: 20px;
            margin: 30px 0;
            border-radius: 4px;
        }
        .success-box h2 {
            color: #4caf50;
            margin-top: 0;
        }
        .credential-details {
            background-color: #f9f9f9;
            border-left: 4px solid #2196f3;
            padding: 15px;
            margin: 20px 0;
            border-radius: 4px;
        }
        .detail-row {
            margin: 10px 0;
            font-size: 14px;
        }
        .detail-label {
            font-weight: bold;
            color: #666;
        }
        .detail-value {
            color: #333;
            margin-left: 10px;
        }
        .security-notice {
            background-color: #e3f2fd;
            border-left: 4px solid #2196f3;
            padding: 15px;
            margin: 20px 0;
            border-radius: 4px;
            color: #1565c0;
            font-size: 14px;
        }
        .footer {
            background-color: #f9f9f9;
            border-top: 1px solid #ddd;
            padding: 20px;
            font-size: 12px;
            color: #666;
            text-align: center;
        }
        .footer a {
            color: #4caf50;
            text-decoration: none;
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="header">
            <h1>✅ {{credentialType == 'password' ? 'Password Changed' : 'Email Changed'}}</h1>
        </div>
        
        <div class="content">
            <div class="message">
                <p>Hello,</p>
                <p>{{message}}</p>
            </div>

            <div class="success-box">
                <h2>✓ Change Successful</h2>
                <p>Your {{credentialType}} has been successfully updated on {{timestamp}}</p>
            </div>

            {{#if newValue}}
            <div class="credential-details">
                <div class="detail-row">
                    <span class="detail-label">New Email:</span>
                    <span class="detail-value">{{newValue}}</span>
                </div>
            </div>
            {{/if}}

            <div class="security-notice">
                <strong>🔒 Account Security:</strong><br>
                {{#if credentialType == 'password'}}
                    Your account has been logged out from all other devices for security. Please log in again on your current device.
                {{else}}
                    You have received this email in addition to the one sent to your new email address.
                {{/if}}
            </div>

            <p style="color: #666; font-size: 14px;">
                If you didn't make this change or notice any unusual activity, please <a href="mailto:{{supportEmail}}" style="color: #4caf50;">contact our support team</a> immediately.
            </p>
        </div>

        <div class="footer">
            <p>© 2026 SkillMind. All rights reserved.</p>
            <p>Questions? Contact us at <a href="mailto:{{supportEmail}}">{{supportEmail}}</a></p>
            <p style="font-size: 11px; color: #999;">This is an automated message. Please do not reply to this email.</p>
        </div>
    </div>
</body>
</html>
