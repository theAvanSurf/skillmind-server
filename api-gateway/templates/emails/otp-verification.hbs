<html>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Verification Code - SkillMind</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            background-color: #f5f5f5;
            margin: 0;
            padding: 20px;
        }
        .container {
            max-width: 600px;
            margin: 0 auto;
            background-color: #ffffff;
            border-radius: 8px;
            box-shadow: 0 2px 8px rgba(0,0,0,0.1);
            overflow: hidden;
        }
        .header {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            padding: 30px 20px;
            text-align: center;
        }
        .header h1 {
            margin: 0;
            font-size: 28px;
        }
        .content {
            padding: 30px;
        }
        .message {
            color: #333;
            line-height: 1.6;
            margin-bottom: 20px;
        }
        .code-container {
            background-color: #f0f0f0;
            border-left: 4px solid #667eea;
            padding: 20px;
            margin: 30px 0;
            text-align: center;
        }
        .code {
            font-size: 36px;
            font-weight: bold;
            color: #764ba2;
            letter-spacing: 5px;
            font-family: 'Courier New', monospace;
        }
        .expiration {
            color: #e74c3c;
            font-weight: bold;
            margin-top: 15px;
            font-size: 14px;
        }
        .action-type {
            background-color: #e8f5e9;
            border-left: 4px solid #4caf50;
            padding: 15px;
            margin: 20px 0;
            border-radius: 4px;
        }
        .warning {
            background-color: #fff3cd;
            border-left: 4px solid #ffc107;
            padding: 15px;
            margin: 20px 0;
            border-radius: 4px;
            color: #856404;
            font-size: 14px;
        }
        .footer {
            background-color: #f9f9f9;
            border-top: 1px solid #ddd;
            padding: 20px;
            font-size: 12px;
            color: #666;
            text-align: center;
        }
        .footer a {
            color: #667eea;
            text-decoration: none;
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="header">
            <h1>🔐 Verification Code</h1>
        </div>
        
        <div class="content">
            <div class="message">
                <p>Hello,</p>
                <p>{{message}}</p>
            </div>

            <div class="action-type">
                <strong>{{actionType}} Request</strong>
            </div>

            <div class="code-container">
                <h2 style="margin: 0 0 10px 0; color: #666;">Your Verification Code</h2>
                <div class="code">{{code}}</div>
                <div class="expiration">⏰ Expires in {{expirationMinutes}} minutes</div>
            </div>

            <div class="warning">
                <strong>⚠️ Security Notice:</strong><br>
                This code is for your {{actionType | lower}} change request.<br>
                <strong>Never share this code with anyone.</strong> SkillMind staff will never ask for it.
            </div>

            <p style="color: #666; font-size: 14px;">
                If you didn't request this {{actionType | lower}} change, please ignore this email or contact our support team immediately.
            </p>
        </div>

        <div class="footer">
            <p>© 2026 SkillMind. All rights reserved.</p>
            <p>Need help? Contact us at <a href="mailto:{{supportEmail}}">{{supportEmail}}</a></p>
            <p style="font-size: 11px; color: #999;">This is an automated message. Please do not reply to this email.</p>
        </div>
    </div>
</body>
</html>
